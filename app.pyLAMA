# -----------------------------------------------------------------------------
# 2. FILE PENYIMPANAN LOKAL (PERSISTENCE)
# -----------------------------------------------------------------------------
CONFIG_FILE = ".activation_config.json"
PROJECTS_FILE = ".recent_projects.json"

def load_activation_key():
    if os.path.exists(CONFIG_FILE):
        try:
            with open(CONFIG_FILE, "r") as f:
                data = json.load(f)
                return data.get("activation_code", "")
        except:
            return ""
    return ""

def save_activation_key(code):
    with open(CONFIG_FILE, "w") as f:
        json.dump({"activation_code": code}, f)

def load_recent_projects():
    if os.path.exists(PROJECTS_FILE):
        try:
            with open(PROJECTS_FILE, "r") as f:
                return json.load(f)
        except:
            return {}
    return {}

def save_project_to_history(title, show_bible, scenes):
    projects = load_recent_projects()
    projects[title] = {
        "show_bible": show_bible,
        "scenes": scenes,
        "timestamp": time.strftime("%Y-%m-%d %H:%M")
    }
    with open(PROJECTS_FILE, "w") as f:
        json.dump(projects, f, indent=2)

